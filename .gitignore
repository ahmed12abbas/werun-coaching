# The coach's own-account Garmin tooling stays local: it talks to Garmin's
# private endpoints with a personal token store, and none of it belongs in a
# public repo.
garmin-mcp/

# Local preview and personal MCP config stay out; the shared Claude Code
# setup (hooks, skills, agents, settings) is versioned.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
!.claude/agents/
.mcp.json

.dev.vars
node_modules/
.wrangler/
.DS_Store
Thumbs.db

# Playwright MCP scratch output
.playwright-mcp/
*.playwright.png

# Assembled by the deploy workflow (and by hand when testing wrangler pages dev)
_site/

# Generated on demand by tools/schema-dump.js for setting a database up by hand
werun-schema.sql

# graphify knowledge graph, built locally by /graphify — regenerable, never shipped
graphify-out/
