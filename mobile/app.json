{
  "expo": {
    "name": "WE RUN Club",
    "slug": "werun-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0b0f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weruncoaching.club",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the coach's check-in code at the track.",
        "NSLocationWhenInUseUsageDescription": "Confirm you are at the meeting point when you check in."
      }
    },
    "android": {
      "package": "com.weruncoaching.club",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0b0b0f",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    }
  }
}
